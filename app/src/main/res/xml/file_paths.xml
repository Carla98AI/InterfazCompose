<?xml version="1.0" encoding="utf-8"?>


<!-- ARCHIVO: file_paths.xml -->
<!-- FUNCIÓN: define las rutas de archivos compartidos. -->
<!-- CONEXIÓN: AndroidManifest, FileProvider y HomeScreen. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- EXTERNAL-FILES-PATH: utiliza almacenamiento externo privado de la app. -->
    <!-- NAME: identificador de la ruta compartida. -->
    <!-- PATH: permite compartir archivos dentro de Pictures. -->
    <external-files-path name="room_photos" path="Pictures/" />
</paths>
